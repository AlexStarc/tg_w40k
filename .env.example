# --- core (required) ---
BOT_TOKEN=123456:your-bot-token-from-botfather
ADMIN_ID=123456789
CHAT_ID=-1001234567890
GLM_API_KEY=your-glm-api-key

# --- memes (optional) ---
# channel the bot publishes crisiswoman memes to (numeric id or @username).
# The bot must be an admin of this channel. Omit to keep memes preview-only.
MEME_CHANNEL_ID=@crisiswoman
# image sources — any subset works; the fallback chain covers the rest.
PEXELS_API_KEY=
UNSPLASH_API_KEY=
PIXABAY_API_KEY=

# --- meme channel sources (optional; needs a Telegram user-session) ---
# Get api_id/api_hash at https://my.telegram.org → API development tools.
# Run `python auth_telethon.py` once to create the .session file (interactive
# login: phone + code from Telegram + optional 2FA password). The bot uses
# the resulting session read-only afterwards.
TG_API_ID=
TG_API_HASH=
TG_SESSION=tg_w40k_user
# Comma-separated channel handles/links to learn punchlines & style from.
MEME_SOURCE_CHANNELS=@kateeeeg,@danya_vologda,@pnd_chapiteau
# How many quote pairs to extract per channel per harvest run (manual or daily).
MEME_HARVEST_PER_CHANNEL=3

# --- runtime (optional) ---
# force a specific proxy; if unset, the bot tries direct then the TG_PROXIES list.
TG_PROXY=
