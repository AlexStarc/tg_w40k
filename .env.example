# --- core (required) ---
BOT_TOKEN=123456:your-bot-token-from-botfather
ADMIN_ID=123456789
CHAT_ID=-1001234567890
GLM_API_KEY=your-glm-api-key

# --- memes (optional) ---
# channel the bot publishes crisiswoman memes to (numeric id or @username).
# The bot must be an admin of this channel. Omit to keep memes preview-only.
MEME_CHANNEL_ID=@crisiswoman
# image sources — any subset works; the fallback chain covers the rest.
PEXELS_API_KEY=
UNSPLASH_API_KEY=
PIXABAY_API_KEY=

# --- meme channel sources (optional; needs a Telegram user-session) ---
# Get api_id/api_hash at https://my.telegram.org → API development tools.
# Run `python auth_telethon.py` once to create the .session file (interactive
# login: phone + code from Telegram + optional 2FA password). The bot uses
# the resulting session read-only afterwards.
TG_API_ID=
TG_API_HASH=
TG_SESSION=tg_w40k_user
# Comma-separated channel handles/links to learn punchlines & style from.
# Channels with image-only posts (no captions) are enriched via GLM-4V vision:
# each new image is downloaded, described, and the description is cached in
# channel_posts.text — pipeline downstream treats it as a regular caption.
MEME_SOURCE_CHANNELS=@kateeeeg,@danya_vologda,@pnd_chapiteau
# How many quote pairs to extract per channel per harvest run (manual or daily).
MEME_HARVEST_PER_CHANNEL=3
# Vision model used to caption image-only posts. Default: glm-4v-plus via z.ai.
VISION_MODEL=glm-4v-plus
VISION_MAX_TOKENS=600

# --- runtime (optional) ---
# Bot API proxies tried in order when a direct connection to api.telegram.org
# fails. Comma-separated. Schemes: socks5://, socks5h://, socks4://, http://.
TG_PROXIES=socks5://182.48.78.141:8008,socks5://72.195.34.35:27360,socks5://174.75.211.193:4145
# Force a single proxy (overrides TG_PROXIES for testing): leave empty normally.
TG_PROXY=
# Telethon (channel harvest) proxy override. If unset, channel_sources uses
# TG_PROXIES[0]. Same URL format as above.
TG_TELETHON_PROXY=
# Telethon MTProto proxies (Telegram-native; only Telethon uses them — aiogram
# can't). Comma-separated 'host:port:secret'. secret is hex/base64 from the
# provider. Tried in order before SOCKS/direct. Example:
# TG_MTPROTO_PROXIES=mtproxy.example.com:443:deadbeefcafebabe0000111122223333
TG_MTPROTO_PROXIES=

# --- proxy pool (optional last-resort fallback) ---
# When all TG_PROXIES fail at startup, the bot samples a public SOCKS5 list,
# tests up to PROXY_POOL_SAMPLE entries concurrently against api.telegram.org,
# and uses the first that responds. Result is cached in DB across runs.
# Comma-separated raw URLs (one host:port per line in each file).
PROXY_REMOTE_SOURCES=https://raw.githubusercontent.com/SevenworksDev/proxy-list/main/proxies/socks5.txt
PROXY_POOL_SAMPLE=100
PROXY_POOL_TIMEOUT=4
PROXY_POOL_CONCURRENCY=20
PROXY_POOL_CACHE_TTL=86400

# Periodic session liveness probe (seconds). Every interval the bot pings
# get_me() through the current session; on failure it rotates to a fresh proxy
# (TG_PROXIES first, then the remote pool) without restarting the process.
# Set to 0 to disable.
HEALTH_CHECK_INTERVAL=1800
